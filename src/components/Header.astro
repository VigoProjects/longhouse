---
import Logo from "./Logo.astro";
import { site, telHref } from "../lib/site";
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-paper/90 backdrop-blur">
  <div class="container-page flex h-18 items-center justify-between gap-6">
    <a href="/" class="text-moss-900" aria-label={`${site.name} — home`}><Logo /></a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-8 text-sm font-medium">
      {site.nav.map((l) => (
        <a href={l.href} class:list={["hover:text-oak transition-colors", path === l.href && "text-oak"]} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>
      ))}
      <a href={telHref} class="text-muted hover:text-oak">{site.phone}</a>
      <a href={site.cta.href} class="rounded-sm bg-moss-900 px-4 py-2.5 text-paper font-semibold hover:bg-moss-800 transition-colors">{site.cta.label}</a>
    </nav>

    <details class="lg:hidden group relative">
      <summary class="list-none cursor-pointer p-2 -mr-2" aria-label="Menu">
        <svg class="size-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        <svg class="size-6 hidden group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <nav aria-label="Mobile" class="fixed inset-x-0 top-18 border-b border-stone-200 bg-paper px-5 pb-8 pt-4 shadow-lg">
        <ul class="flex flex-col divide-y divide-stone-200 text-lg font-serif">
          {site.nav.map((l) => <li><a href={l.href} class="block py-3">{l.label}</a></li>)}
          <li><a href={telHref} class="block py-3">{site.phone}</a></li>
        </ul>
        <a href={site.cta.href} class="mt-5 block rounded-sm bg-moss-900 px-5 py-3 text-center font-semibold text-paper">{site.cta.label}</a>
      </nav>
    </details>
  </div>
</header>
<script>
  // Close the mobile menu after tapping an in-page link.
  document.querySelectorAll("header details nav a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")));
</script>
