---
import { marked } from "marked";
import Img from "../Img.astro";
const { id, background = "paper", eyebrow, heading, body, image, imageSide = "right", isPageTitle } = Astro.props;
const html = await marked.parse(body);
const H = isPageTitle ? "h1" : "h2";
---
<section id={id} class:list={[`tone-${background}`, "section scroll-mt-24"]}>
  <div class:list={["container-page grid items-center gap-12 lg:gap-20", image ? "lg:grid-cols-2" : "max-w-3xl"]}>
    <div class:list={[image && imageSide === "left" && "lg:order-2"]}>
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      {heading && <H class="text-4xl lg:text-5xl">{heading}</H>}
      <div class="prose prose-lg mt-6 max-w-none prose-p:text-muted prose-a:text-olive-dark" set:html={html} />
    </div>
    {image && <Img src={image.src} alt={image.alt} class="aspect-[4/5] w-full rounded-sm object-cover" />}
  </div>
</section>
