---
/** Numbered stages of a build. Each stage expands on mobile; all open on desktop. */
const { id, background = "paper", eyebrow, heading, body, items, isPageTitle } = Astro.props;
const H = isPageTitle ? "h1" : "h2";
---
<section id={id} class:list={[`tone-${background}`, "section scroll-mt-24"]}>
  <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}
      <H class="text-4xl lg:text-5xl">{heading}</H>
      {body && <p class="mt-6 max-w-md text-muted">{body}</p>}
    </div>
    <ol class="border-t border-stone-400/50">
      {items.map((s: { title: string; items: string[] }, i: number) => (
        <li class="border-b border-stone-400/50">
          <details class="group py-6 lg:py-8" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-baseline gap-6">
              <span class="font-serif text-lg text-olive-dark tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="flex-1 text-2xl lg:text-3xl">{s.title}</h3>
              <span aria-hidden="true" class="text-2xl font-light text-muted transition-transform group-open:rotate-45">+</span>
            </summary>
            <ul class="mt-5 grid gap-x-8 gap-y-2 pl-12 text-[0.97rem] text-muted sm:grid-cols-2">
              {s.items.map((it) => <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2 before:bg-olive-dark">{it}</li>)}
            </ul>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>
